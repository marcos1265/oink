<!-- Android 11 (fullBackupContent). Same as the cloud-backup section of
     data_extraction_rules.xml; see the reasons there. This format has no
     separate device-transfer rules, so attachments stay behind on Android 11
     device transfer as well. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="device_sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
